{
  "geode": "6.0.0-beta.1",
  "gd": {
    "win": "2.2091",
    "mac": "2.2091",
    "android": "2.2091",
    "ios": "2.2091"
  },
  "version": "v0.1.0",
  "id": "fakeskyline.fusion",
  "name": "Fusion",
  "links": {
    "homepage": "https://github.com/fakeskyline/fusion.menu",
    "source": "https://github.com/fakeskyline/fusion.menu"
  },
  "api": {
    "include": ["include/*.hpp"]
  },
  "tags": ["cheat", "gameplay", "utility", "customization", "interface"],
  "developers": [
    "Fusion Team",
    "Eclipse Team",
    "ninXout",
    "prevter",
    "maxnut",
    "Firee",
    "SpaghettDev"
  ],
  "description": "A next-generation mod menu for Geometry Dash.",
  "early-load": true,
  "resources": {
    "files": [
      "resources/Blur/*.glsl",
      "resources/Fonts/*.ttf",
      "resources/Licenses/*.txt",
      "resources/Themes/*.json",
      "resources/translations/*.json",
      "resources/BitmapFonts/font_default*"
    ],
    "sprites": [
      "resources/ECLIPSE-android.png"
    ],
    "spritesheets": {
      "emojis": ["resources/Emojis/*.png"],
      "UISheet": ["resources/UISheet/*.png"]
    }
  },
  "dependencies": {
    "eclipse.ffmpeg-api": {
      "version": ">=1.2.0",
      "required": false
    }
  },
  "settings": {
    "legacy-render": {
      "name": "Use Legacy rendering",
      "description": "Disables some newer OpenGL features, which can solve some rendering issues on older hardware (at the cost of performance).",
      "type": "bool",
      "default": false
    },
    "reset-theme": {
      "type": "custom:custom-btn",
      "name": "Reset theme?",
      "description": "Reset the theme to the default one.",
      "default": "Reset"
    },
    "menu-keybind": {
      "type": "custom:keybind",
      "name": "Menu Keybind",
      "description": "The keybind to open the Fusion menu.",
      "platforms": ["win", "mac"]
    },
    "menu-style": {
      "name": "Menu Style",
      "description": "Choose the style of the Fusion menu.",
      "type": "string",
      "one-of": ["ImGui", "Cocos"],
      "default": {
        "win": "ImGui",
        "mac": "ImGui",
        "android": "Cocos",
        "ios": "Cocos"
      }
    }
  }
}
